# ============================================================
# Backend Environment Configuration
# ============================================================
# Supabase PostgreSQL Connection String
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Express Server Port
PORT=5000

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Node Environment (development | production | test)
NODE_ENV=development

# ============================================================
# Frontend Environment Configuration (for reference)
# ============================================================
# Base URL for Express backend API
VITE_API_BASE_URL=http://localhost:5000/api
