{
  "name": "intern-leave-management-assignment",
  "version": "1.0.0",
  "description": "Employee Leave Management System for Omibits Internship Assessment",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "leave-management",
    "internship",
    "react",
    "express",
    "postgresql",
    "supabase"
  ],
  "author": "Sadeepa Bandara",
  "license": "Apache-2.0"
}
